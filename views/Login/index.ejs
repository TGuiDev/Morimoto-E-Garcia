<%- include('../partials/admin/header'); %>
<%- include('../partials/admin/navbar'); %>
<style>
    .navbar-dark {
        position: fixed !important;
        width: 100%;
        top: 0;
        left: 0;
        border-bottom: 1px solid rgba(256, 256, 256, .1);
        z-index: 999;
    }
    .bg-header {
        background: linear-gradient(rgba(9, 30, 62, 0.7), rgba(9, 30, 62, 0.7)), url(../img/banners/login.jpg) center center no-repeat;
        background-size: cover;
    }
</style>

<% if (successMessage) { %>
    <div class="alert alert-danger" id="success">
        <%= successMessage %>
    </div>
<% } %>

<div class="container-fluid bg-primary py-5 bg-header" style="margin-bottom: 90px;">
    <div class="row py-5">
        <div class="col-12 pt-lg-5 mt-lg-5 text-center">
            <h1 class="display-4 text-white animated zoomIn">Login</h1>
        </div>
    </div>
</div>


<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <form action="/login" method="post">
                <div class="mb-3">
                    <label for="username" class="form-label">Email</label>
                    <input name="username" type="text" class="form-control" style="border-radius: 5px;" id="username" placeholder="Email de Acesso">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Senha</label>
                    <input name="password" type="password" class="form-control" style="border-radius: 5px;" id="password" placeholder="Senha de Acesso">
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary not-hover">Entrar</button>
                </div>
            </form>
        </div>
    </div>
</div>





<%- include('../partials/footer'); %>