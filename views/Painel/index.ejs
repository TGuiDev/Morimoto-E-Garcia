<%- include('../partials/admin/header'); %>
<%- include('../partials/admin/navbar'); %>
<style>
    .navbar-dark {
        position: fixed !important;
        width: 100%;
        top: 0;
        left: 0;
        border-bottom: 1px solid rgba(256, 256, 256, 0.1);
        z-index: 999;
    }

    .bg-header {
        background: linear-gradient(rgba(9, 30, 62, 0.7), rgba(9, 30, 62, 0.7)), url(../img/banners/advogado.jpg) center center no-repeat;
        background-size: cover;
    }
</style>

<% if (successMessage) { %>
    <div class="alert alert-success" id="success">
        <%= successMessage %>
    </div>
<% } %>

<div class="container-fluid bg-primary py-5 bg-header" style="margin-bottom: 90px">
    <div class="row py-5">
        <div class="col-12 pt-lg-5 mt-lg-5 text-center">
            <h1 class="display-4 text-white animated zoomIn">Painel de Admin</h1>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="row mt-5 justify-content-center">
        <div class="col-md-2">
            <button class="btn bg-secondary roundeding" data-bs-toggle="modal"
                data-bs-target="#modalOpcaoMenu1">
                <img src="../img/opcoes/novocliente.png" alt="Opção 1" class="img-fluid" />
                <div class="mt-2">Clientes</div>
            </button>
        </div>

        <% if (currentUser.credencial.acesso == 'SA') { %>
            <div class="col-md-2">
                <button class="btn bg-secondary roundeding" data-bs-toggle="modal"
                    data-bs-target="#modaladdlogin">
                    <img src="../img/opcoes/novologin.png" alt="Opção 3" class="img-fluid" />
                    <div class="mt-2">Usuários de Login</div>
                </button>
            </div>
            <% }  else { %>
        <% } %>

        <div class="col-md-2">
            <button class="btn bg-secondary roundeding" data-bs-toggle="modal"
                data-bs-target="#modalOpcaoMenuImprimir">
                <img src="../img/opcoes/declaracao.png" alt="Opção 3" class="img-fluid" />
                <div class="mt-2">Procuração e Declaração</div>
            </button>
        </div>
        <div class="col-md-2">
            <button class="btn bg-secondary roundeding" data-bs-toggle="modal"
                data-bs-target="#modalOpcao4">
                <img src="../img/opcoes/recibo.png" alt="Opção 4" class="img-fluid" />
                <div class="mt-2">Recibo</div>
            </button>
        </div>
    </div>
    <div class="row mt-2 justify-content-center">
        <div class="col-md-2">
            <style>
                a:hover {
                    color: gray;
                }
            </style>
            <a class="btn bg-secondary roundeding" href="/orcamento">
                <img src="../img/opcoes/email.png" alt="Opção 4" class="img-fluid" />
                <div class="mt-2">Form de Contato</div>
            </a>
        </div>
        
        <% if (currentUser.credencial.acesso == 'SA') { %>
            <div class="col-md-2">
                <a class="btn bg-secondary roundeding" href="/backup">
                    <img src="../img/opcoes/database.png" alt="Opção 5" class="img-fluid" />
                    <div class="mt-2">Backup</div>
                </a>
            </div>
        <% }  else { %>
            
        <% } %>
        <div class="col-md-2">
            <button class="btn bg-secondary roundeding" data-bs-toggle="modal"
                data-bs-target="#modalnovanoticia">
                <img src="../img/opcoes/postagem.png" alt="Opção 5" class="img-fluid" />
                <div class="mt-2">Postagem</div>
            </button>
        </div>
    </div>
</div>


<%- include('./partials/menucliente.ejs'); %>
<%- include('./partials/cadnovocliente.ejs'); %>
<%- include('./partials/cadnovologin.ejs'); %>
<%- include('./partials/cadgrupodeclientes.ejs'); %>
<%- include('./partials/cadnovanoticia.ejs'); %>

<%- include('./partials/menuimprimir.ejs'); %>
<%- include('./partials/imprimirprocuracao.ejs'); %>
<%- include('./partials/imprimirdeclaracao.ejs'); %>


<%- include('../partials/footer'); %>