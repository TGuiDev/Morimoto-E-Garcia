<div class="modal fade" id="modalnovanoticia" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">
                    Postar Notícia
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="/cadnoticia" method="post">
                    <div class="mb-3">
                        <label for="titulonoticia" class="form-label">Título</label>
                        <input name="titulonoticia" type="text" class="form-control" style="border-radius: 5px"
                            id="titulonoticia" placeholder="" />
                    </div>
                    <div class="mb-3">
                        <label for="descposagem" class="form-label">Descrição</label>
                        <textarea name="descposagem" type="text" class="form-control" style="border-radius: 5px; min-height: 500px;"
                            id="descposagem" placeholder=""></textarea> 
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-danger px-3" data-bs-dismiss="modal">
                            <i class="fa-solid fa-circle-xmark"></i> Cancelar
                        </button>
                        <button type="submit" class="btn btn-success px-3">
                            <i class="fa-solid fa-circle-plus"></i> Criar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>