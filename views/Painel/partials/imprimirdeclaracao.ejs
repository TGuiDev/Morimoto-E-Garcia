<style>
    a{
        font-weight: bolder;
    }
</style>


<script>
function imprimirPerfil() {
    const opcoes = 'width=1600,height=1200,toolbar=no,scrollbars=no,resizable=yes';
    const janelaDeImpressao = window.open('', '', opcoes);

    if (janelaDeImpressao) {
        const nomedeclaracao    = document.getElementById('nomedeclaracao').value;
        const nacionalidade     = document.getElementById('nacionalidadedeclaracao').value;
        const estadocivildeclaracao       = document.getElementById('estadocivildeclaracao').value;
        const profissaodeclaracao         = document.getElementById('profissaodeclaracao').value;
        const rgdeclaracao      = document.getElementById('rgdeclaracao').value;
        const cpf               = document.getElementById('cpfdeclaracao').value
        const cidade            = document.getElementById('cidadedeclaracao').value;
        const ncasadeclaracao             = document.getElementById('ncasadeclaracao').value;
        const bairro            = document.getElementById('bairrodeclaracao').value;
        const estado            = document.getElementById('estadodeclaracao').value;
        const rua               = document.getElementById('ruadeclaracao').value;
        const cep               = document.getElementById('cepdeclaracao').value;

        // Supondo que a data esteja no formato YYYY-MM-DD
        const dataOriginal = new Date(document.getElementById('datadeclaracao').value);
        const dia = dataOriginal.getDate() + 1;
        const mes = dataOriginal.toLocaleString('default', { month: 'long' });
        const ano = dataOriginal.getFullYear();

        const dataFormatada = `${dia} de ${mes} de ${ano}`;



        const conteudoImprimir = `
        <!DOCTYPE html>
<html>
<head>
    <style type="text/css">
        .container {
            margin-top: 20px;
            text-align: justify;
            font-weight: normal;
            font-size: 16px;
            word-spacing: 7px;
        }

        .outorgante {
            font-weight: bold;
        }

        .powers {
            font-weight: bold;
        }

        .title {
            text-align: center;
        }

        .mt1{
            margin-top: 9vh;
        }

        .mt2{
            margin-top: 11vh;
        }
        .centro {
            margin: 0 auto !important;
            max-width: 90%;
        }
    </style>
</head>
<body>

    <p class='container title' style='font-weight: bold;'>DECLARAÇÃO DE ESTADO DE POBREZA PARA FINS JUDICIAIS</p>

    <div class='container centro'>
        <p>${nomedeclaracao}, ${nacionalidade}, ${estadocivildeclaracao}, ${profissaodeclaracao}, portador da cédula de identidade RG/SSP nº: ${rgdeclaracao}, inscrito no CPF/MF nº: ${cpf}, , residente e domiciliado à Rua ${rua} Nº ${ncasadeclaracao}, ${bairro}, na cidade de ${cidade}, ${estado}, CEP: ${cep}, venho declarar que, em razão de minha atual condição financeira, não tenho condições de arcar com nenhum tipo de pagamento de custos processuais, sob pena de implicar em prejuízo próprio e de minha família, nos termos do Art. 5º, LXXIV, da Constituição da República, da Lei nº 1.060/50, bem como nos artigos 82 e 98 do Novo Código de Processo Civil.</p>
    </div>

    <div class='container centro'>
        <p>
            Reiterando minha incapacidade de custear quaisquer ações, quero solicitar, ainda, que tal benefício abranja todos os atos do processo, de acordo com o artigo 98 do novo Código de Processo Civil.
        </p>
    </div>

<div class='title'>
        <p class="mt1">${cidade}, ${dataFormatada} </p>
        <p class='mt2'>________________________________________________</p>
    </div>
</body>
</html>


        `;

        janelaDeImpressao.document.write(conteudoImprimir);

        janelaDeImpressao.onafterprint = function () {
            janelaDeImpressao.close();
        };

        janelaDeImpressao.document.addEventListener("DOMContentLoaded", function() {
            const links = janelaDeImpressao.document.querySelectorAll("a");
            for (const link of links) {
                if (link.href === "about:blank") {
                    link.style.display = "none";
                }
            }
        })
        ;

        janelaDeImpressao.print();
    } else {
        alert("Por favor, desabilite o bloqueio de pop-ups para imprimir.");
    }
}


</script>