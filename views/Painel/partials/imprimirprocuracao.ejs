<style>
    a{
        font-weight: bolder;
    }
</style>


<script>
function imprimirPerfil() {
    const opcoes = 'width=1600,height=1200,toolbar=no,scrollbars=no,resizable=yes';
    const janelaDeImpressao = window.open('', '', opcoes);

    if (janelaDeImpressao) {
        const nomeoutorgante = document.getElementById('nomeoutorgante').value;
        const nacionalidade = document.getElementById('nacionalidade').value;
        const estadocivil = document.getElementById('estadocivil').value;
        const profissao = document.getElementById('profissao').value;
        const rgoutorgante = document.getElementById('rgoutorgante').value;
        const cidade = document.getElementById('cidadee').value;
        const bairro = document.getElementById('Bairro').value;
        const rua = document.getElementById('rua').value;
        const cep = document.getElementById('cepe').value;

        const conteudoImprimir = `
        <style type="text/css">
            @media print {
                .date, .url {
                    display: none !important;
                }
            }
        </style>
        <p style='text-align: center; text-decoration: underline; font-weight: bolder;'>PROCURAÇÃO “AD JUDICIA”</p>
        
        <div class='container' style='margin-top: 5vh;'>
            <p><span style='font-weight: bolder;'>OUTORGANTE(s):</span> ${nomeoutorgante}, ${nacionalidade}, ${estadocivil}, ${profissao}, portador da cédula de identidade RG/SSP nº: ${rgoutorgante} e domiciliado à Rua ${rua}, ${bairro}, CEP: ${cep}.</p>
        </div>

        <div class='container' style='margin-top: 5vh;'>
            <p><span style='font-weight: bolder;'>OUTORGADO(s): MARCELO GARCIA FRANCISCO</span>, brasileiro, divorciado, portador do CPF n.º 047.148.388-57, inscrito na OAB/SP sob o n.º 286.236-D, e, <span style='font-weight: bolder;'>FERNANDO MORIMOTO JUNIOR</span>, brasileiro, casado, advogado, inscrito na OAB/SP sob o nº 255.136 e portador do CPF: 855.804.659-04, ambos com escritório na Rua Artur Vergueiro, n.º 537, Alto Alegre, em Espírito Santo do Pinhal/SP, CEP 13990-000, tel. (019) 3651-3106.</p>
        </div>

        <div class='container' style='margin-top: 5vh;'>
            <p><span style='font-weight: bolder;'>PODERES:</span> Pelo presente instrumento particular de procuração, nomeia(m) e constitui (em) seu bastante procurador o advogado, a quem confere(m) amplos poderes, conforme estabelecido no artigo 105 do Novo Código de Processo Civil para, com cláusula “ad judicia”, em qualquer juízo, instância ou tribunal, podendo propor contra quem de direito as ações competentes e defendê-los nas contrárias, seguindo umas e outras, até a final decisão, usando dos recursos legais e acompanhando-os, conferindo-lhe(s), ainda poderes especiais desistir, firmar compromisso de inventariante, primeiras e últimas declarações em inventário, benefícios da justiça gratuita, receber e dar quitação, em especial o levantamento de Precatórios, Registros de Pequeno Valor (RPV) e Alvarás, inclusive poderes para assinar declaração de isenção de imposto de renda junto a qualquer Banco ou Repartição Pública, receber intimações, assinar termos e firmar compromissos ou acordos, assinar auto de arrematação, requerer extinção de processos, agindo em conjunto ou separadamente, podendo ainda substabelecer está em outrem, com ou sem reserva de poderes, dando tudo por bom e valioso.</p>
        </div>
        `;

        janelaDeImpressao.document.write(conteudoImprimir);

        janelaDeImpressao.onafterprint = function () {
            janelaDeImpressao.close();
        };

        janelaDeImpressao.document.addEventListener("DOMContentLoaded", function() {
            const links = janelaDeImpressao.document.querySelectorAll("a");
            for (const link of links) {
                if (link.href === "about:blank") {
                    link.style.display = "none";
                }
            }
        })
        ;

        janelaDeImpressao.print();
    } else {
        alert("Por favor, desabilite o bloqueio de pop-ups para imprimir.");
    }
}


</script>