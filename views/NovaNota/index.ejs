<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Adicionar Nota</title>
    <!-- Inclua os links para o Bootstrap CSS e JS aqui -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="container">
        <h1 class="mt-5">Adicionar Nota a Cliente</h1>
        <form action="/clientes/<%= clienteId %>/notas" method="POST">
            <div class="form-group">
                <label for="texto">Texto da Nota:</label>
                <textarea class="form-control" id="texto" name="texto" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Nota</button>
        </form>
    </div>
    <!-- Inclua os scripts do Bootstrap JS aqui -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
