<%- include('../partials/header'); %>
<%- include('../partials/navbar'); %>
<title>Clientes</title>
<style>
    .navbar-dark {
        position: fixed !important;
        width: 100%;
        top: 0;
        left: 0;
        border-bottom: 1px solid rgba(256, 256, 256, 0.1);
        z-index: 999;
    }

    .bg-header {
        background: linear-gradient(rgba(9, 30, 62, 0.7), rgba(9, 30, 62, 0.7)), url(../img/banners/advogado.jpg) center center no-repeat;
        background-size: cover;
    }
</style>

<div class="container-fluid bg-primary py-5 bg-header" style="margin-bottom: 90px">
    <div class="row py-5">
        <div class="col-12 pt-lg-5 mt-lg-5 text-center">
            <h1 class="display-4 text-white animated zoomIn">Painel de Admin</h1>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h1 class="mb-4">Clientes Cadastrados</h1>
    <div class="mb-4">
        <input type="text" id="cpfInput" class="form-control" placeholder="Pesquisar por CPF">
    </div>
    <ul class="list-group" id="clientesList">
        <% clientes.forEach(cliente => { %>
            <a href="/clientes/<%= cliente._id %>" class="list-group-item">
                <p class="mb-0">Id: <%= cliente._id %></p>
                <p class="mb-0">Nome: <%= cliente.info.nome %></p>
                <p class="mb-0">Data de Nascimento: <%= cliente.info.dataNascimento %></p>
                <p class="mb-0">CPF: <%= cliente.info.cpf %></p>
            </a>
        <% }); %>
    </ul>
    <!-- Mensagem de aviso quando nenhum cliente é encontrado -->
    <div class="alert alert-warning mt-4" id="noResults" style="display: none;">
        Nenhum cliente encontrado com o CPF informado.
    </div>
</div>

<%- include('../partials/footer'); %>


<script>
    // Função para filtrar clientes com base no CPF digitado
    document.getElementById('cpfInput').addEventListener('input', function () {
            const cpfInputValue = this.value.trim().toLowerCase();
            const clientes = document.querySelectorAll('.list-group-item');
            let foundResults = false;

            clientes.forEach(cliente => {
                const cpfText = cliente.querySelector('p:nth-child(4)' || 'p:nth-child(2)' ).textContent.toLowerCase();
                if (cpfText.includes(cpfInputValue)) {
                    cliente.style.display = 'block';
                    foundResults = true;
                } else {
                    cliente.style.display = 'none';
                }
            });

            const noResults = document.getElementById('noResults');
            if (foundResults) {
                noResults.style.display = 'none';
            } else {
                noResults.style.display = 'block';
            }
        });
</script>