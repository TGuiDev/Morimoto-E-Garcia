<%- include('../partials/header'); %> 
<%- include('../partials/navbar'); %>
<style>
  .bg-header {
    background: linear-gradient(rgba(9, 30, 62, 0.7), rgba(9, 30, 62, 0.7)),
      url(../img/carousel-1.jpg) center center no-repeat;
    background-size: cover;
  }
</style>

<div id="message" class="err display-none bg-success"><%= message %></div> 

<div
  id="header-carousel"
  class="carousel slide carousel-fade"
  data-bs-ride="carousel"
  style="max-height: 70vh"
>
  <div class="carousel-inner">
    <div class="carousel-item active" style="max-height: 70vh">
      <img class="w-100" src="img/carousel-1.jpg" alt="Image" />
      <div
        class="carousel-caption d-flex flex-column align-items-center justify-content-center"
      >
        <div class="p-3" style="max-width: 900px">
          <h5 class="text-white text-uppercase mb-3 animated slideInDown">
            Escritório de Advocacia
          </h5>
          <h1 class="display-1 text-white mb-md-4 animated zoomIn">
            Consulte um advogado agora
          </h1>
          <a
            href="https://wa.me/+5519991880932"
            class="btn btn-outline-light py-md-3 px-md-5 animated slideInRight"
            >Contate pelo Whatsapp</a
          >
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Service Start -->
<div
  class="container-fluid py-5 wow fadeInUp"
  data-wow-delay="0.1s"
  id="areas-de-atuação"
>
  <div class="container py-5">
    <div
      class="section-title text-center position-relative pb-3 mb-5 mx-auto"
      style="max-width: 600px"
    >
      <h5 class="fw-bold text-primary text-uppercase"></h5>
      <h1 class="mb-0">Áreas de Atuação</h1>
    </div>
    <div class="row g-5 align-items-center justify-content-center">
      <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.3s">
        <a
          class="rounded"
          href="https://api.whatsapp.com/send?phone=5519991880932&text=Boa%20noite,%20gostaria%20de%20saber%20mais%20sobre%20o%20Direito%20Trabalhista"
        >
          <div
            class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center"
          >
            <div class="service-icon">
              <i class="fa fa-shield-alt text-white"></i>
            </div>
            <h4 class="mb-3">Direito Trabalhista</h4>
            <p class="m-0">
              Regras do emprego, abordando contratos, salários e direitos dos
              trabalhadores.
            </p>
          </div>
        </a>
      </div>

      <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.6s">
        <a
          class=""
          href="https://api.whatsapp.com/send?phone=5519991880932&text=Boa%20noite,%20gostaria%20de%20saber%20mais%20sobre%20o%20Direitos%20do%20Consumidor"
        >
          <div
            class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center"
          >
            <div class="service-icon">
              <i class="fa fa-chart-pie text-white"></i>
            </div>
            <h4 class="mb-3">Direito do Consumidor</h4>
            <p class="m-0">
              Proteção dos compradores, cobrindo produtos seguros e práticas
              comerciais justas.
            </p>
          </div>
        </a>
      </div>
      <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.9s">
        <a
          class=""
          href="https://api.whatsapp.com/send?phone=5519991880932&text=Boa%20noite,%20gostaria%20de%20saber%20mais%20sobre%20o%20Direito%20Previdenciário"
        >
          <div
            class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center"
          >
            <div class="service-icon">
              <i class="fa fa-code text-white"></i>
            </div>
            <h4 class="mb-3">Direito Previdenciário</h4>
            <p class="m-0">
              Benefícios sociais, como aposentadoria e auxílio, para cidadãos em
              necessidade.
            </p>
          </div>
        </a>
      </div>
      <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.3s">
        <a
          class=""
          href="https://api.whatsapp.com/send?phone=5519991880932&text=Boa%20noite,%20gostaria%20de%20saber%20mais%20sobre%20o%20Direito%20Criminal"
        >
          <div
            class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center"
          >
            <div class="service-icon">
              <i class="fab fa-android text-white"></i>
            </div>
            <h4 class="mb-3">Direito Criminal</h4>
            <p class="m-0">
              Leis e punições para crimes, como roubo e homicídio, visando a
              segurança da sociedade.
            </p>
          </div>
        </a>
      </div>
      <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.9s">
        <div
          class="position-relative bg-primary rounded h-100 d-flex flex-column align-items-center justify-content-center text-center p-5"
        >
          <h3 class="text-white mb-3">Ligue para tirar Dúvidas</h3>
          <p class="text-white mb-3"></p>
          <h2 class="text-white mb-0">+55 19 99188-0932</h2>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Service End -->

<!-- Quote Start -->
<div
  class="container-fluid py-5 wow fadeInUp"
  data-wow-delay="0.1s"
  id="orçamento"
>
  <div class="container py-5">
    <div class="row g-5">
      <div class="col-lg-7">
        <div class="section-title position-relative pb-3 mb-5">
          <h5 class="fw-bold text-primary text-uppercase">
            Solicite um Orçamento
          </h5>
          <h1 class="mb-0">Precisa de um orçamento grátis?</h1>
        </div>
        <div class="row gx-3">
          <div class="col-sm-6 wow zoomIn" data-wow-delay="0.2s">
            <h5 class="mb-4">
              <i class="fa fa-reply text-primary me-3"></i>Respondemos em 24
              horas
            </h5>
          </div>
        </div>
        <p class="mb-4">Sinta-se à vontade para entrar em contato conosco</p>
        <div
          class="d-flex align-items-center mt-2 wow zoomIn"
          data-wow-delay="0.6s"
        >
          <div
            class="bg-primary d-flex align-items-center justify-content-center rounded"
            style="width: 60px; height: 60px"
          >
            <i class="fa fa-phone-alt text-white"></i>
          </div>
          <div class="ps-4">
            <h5 class="mb-2">Ligue para tirar dúvidas</h5>
            <h4 class="text-primary mb-0">+55 19 99188-0932</h4>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div
          class="bg-primary rounded h-100 d-flex align-items-center p-5 wow zoomIn"
          data-wow-delay="0.9s"
        >
          <form id="orcamento-form" action="/cadorcamento" method="post">
            <div class="row g-4">
              <div class="col-xl-12">
                <input
                  name="nome"
                  id="nome"
                  type="text"
                  class="form-control bg-light border-0"
                  placeholder="Seu Nome (Obrigatório)"
                  style="height: 55px"
                  required
                />
              </div>
              <div class="col-12">
                <input
                  name="phone"
                  id="phone"
                  type="text"
                  class="form-control bg-light border-0"
                  placeholder="Seu Telefone (Obrigatório)"
                  style="height: 55px"
                  required
                />
              </div>
              <div class="col-12">
                <select
                  name="categoria"
                  id="categoria"
                  class="form-select bg-light border-0"
                  style="height: 55px"
                  required
                >
                  <option value="Não Definido" selected>
                    Selecione a Categoria
                  </option>
                  <option value="Direito Trabalhista">
                    Direito Trabalhista
                  </option>
                  <option value="Direito do Consumidor">
                    Direito do Consumidor
                  </option>
                  <option value="Direito Previdenciário">
                    Direito Previdenciário
                  </option>
                  <option value="Direito Criminal">Direito Criminal</option>
                </select>
              </div>
              <div class="col-12">
                <textarea
                  name="mensagem"
                  id="mensagem"
                  class="form-control bg-light border-0"
                  rows="3"
                  placeholder="Mensagem (Opcional)"
                ></textarea>
              </div>
              <div class="col-12">
                <button
                  class="btn btn-dark w-100 py-3"
                  id="orcamento-btn"
                  type="submit"
                >
                  Enviar Mensagem
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Quote End -->

