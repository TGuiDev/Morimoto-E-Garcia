              <h3 class="text-white mb-3">Ligue para tirar Dúvidas</h3>
              <p class="text-white mb-3"></p>
              <h2 class="text-white mb-0">+55 19 99188-0932</h2>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Service End -->

    <!-- Quote Start -->
    <div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s" id="orçamento">
      <div class="container py-5">
        <div class="row g-5">
          <div class="col-lg-7">
            <div class="section-title position-relative pb-3 mb-5">
              <h5 class="fw-bold text-primary text-uppercase">
                Solicite um Orçamento
              </h5>
              <h1 class="mb-0">Precisa de um orçamento grátis?</h1>
            </div>
            <div class="row gx-3">
              <div class="col-sm-6 wow zoomIn" data-wow-delay="0.2s">
                <h5 class="mb-4">
                  <i class="fa fa-reply text-primary me-3"></i>Respondemos em 24
                  horas
                </h5>
              </div>
            </div>
            <p class="mb-4">Sinta-se à vontade para entrar em contato conosco</p>
            <div class="d-flex align-items-center mt-2 wow zoomIn" data-wow-delay="0.6s">
              <div class="bg-primary d-flex align-items-center justify-content-center rounded"
                style="width: 60px; height: 60px">
                <i class="fa fa-phone-alt text-white"></i>
              </div>
              <div class="ps-4">
                <h5 class="mb-2">Ligue para tirar dúvidas</h5>
                <h4 class="text-primary mb-0">+55 19 99188-0932</h4>
              </div>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="bg-primary rounded h-100 d-flex align-items-center p-5 wow zoomIn" data-wow-delay="0.9s">
              <form id="orcamento-form" action="/cadorcamento" method="post">
                <div class="row g-4">
                  <div class="col-xl-12">
                    <input name="nome" id="nome" type="text" class="form-control bg-light border-0"
                      placeholder="Seu Nome (Obrigatório)" style="height: 55px" required />
                  </div>
                  <div class="col-12">
                    <input name="phone" id="phone" type="text" class="form-control bg-light border-0"
                      placeholder="Seu Telefone (Obrigatório)" onkeydown="return mascaraTelefone(event)"
                      style="height: 55px" required />
                  </div>
                  <div class="col-12">
                    <select name="categoria" id="categoria" class="form-select bg-light border-0" style="height: 55px"
                      required>
                      <option value="Não Definido" selected>
                        Selecione a Categoria
                      </option>
                      <option value="Direito Trabalhista">
                        Direito Trabalhista
                      </option>
                      <option value="Direito do Consumidor">
                        Direito do Consumidor
                      </option>
                      <option value="Direito Previdenciário">
                        Direito Previdenciário
                      </option>
                      <option value="Direito Criminal">Direito Criminal</option>
                    </select>
                  </div>
                  <div class="col-12">
                    <textarea name="mensagem" id="mensagem" class="form-control bg-light border-0" rows="3"
                      placeholder="Mensagem (Opcional)"></textarea>
                  </div>
                  <div class="col-12">
                    <button class="btn btn-dark w-100 py-3" id="orcamento-btn" type="submit">
                      Enviar Mensagem
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Quote End -->

