<%- include('../partials/admin/header'); %>
<%- include('../partials/admin/navbar'); %>
<style>
    .navbar-dark {
        position: fixed !important;
        width: 100%;
        top: 0;
        left: 0;
        border-bottom: 1px solid rgba(256, 256, 256, .1);
        z-index: 999;
    }
    .bg-header {
        background: linear-gradient(rgba(9, 30, 62, 0.7), rgba(9, 30, 62, 0.7)), url(../img/banners/orcamento.jpg) center center no-repeat;
        background-size: cover;
    }
</style>

<div class="container-fluid bg-primary py-5 bg-header" style="margin-bottom: 90px;">
    <div class="row py-5">
        <div class="col-12 pt-lg-5 mt-lg-5 text-center">
            <h1 class="display-4 text-white animated zoomIn">Formulário Orçamento Grátis</h1>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-6 mb-4">
            <a href="/painel-admin" class="btn bg-warning br-10 text-white">
                <i class="fa fa-arrow-left" aria-hidden="true"></i> Voltar
            </a>
        </div>
    </div>
    <h1>Tabela de Dados</h1>
    <table class="table table-dark table-striped" style="border-radius: 5px !important; overflow: hidden;">
        <thead>
            <tr>
                <th scope="col">Atendente</th>
                <th scope="col">Status</th>
                <th scope="col">Nome</th>
                <th scope="col">Telefone</th>
                <th scope="col">Categoria</th>
                <th scope="col">Mensagem</th>
                <th scope="col">Data</th>
            </tr>
        </thead>
        <tbody>
            <!-- Aqui você pode iterar sobre seus dados e criar linhas da tabela -->
            <% userData.forEach(function(user) { %>
                <tr>
                    <% if( user.Atendimento.Responsavel == null ){ %>
                        <td style="min-width: 200px !important;">
                            <a href="/contatar/<%= user.ID %>" class="btn btn-success text-white ">Confirmar</a>
                        </td>
                    <% } else { %>
                        <td style="min-width: 200px !important; padding: 14px"><%= user.Atendimento.Responsavel %></td>
                    <% }  %>
                    <td style="min-width: 200px !important; padding: 14px">
                        <% if( user.Atendimento.Status == 1 ){ %>
                            <span class="text-warning ">Atendido</span>
                        <% } else { %>
                            <span class="text-danger">Não Atendido</span>
                        <% }  %>
                    </td>
                    <td style="min-width: 200px !important; padding: 14px"><%= user.Nome %></td>
                    <td style="min-width: 200px !important; padding: 14px"><%= user.Telefone %></td>
                    <td style="min-width: 200px !important; padding: 14px"><%= user.Categoria %></td>
                    <td style="min-width: 200px !important; padding: 14px"><%= user.Mensagem %></td>
                    <td style="min-width: 200px !important; padding: 14px"><%= user.Data %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>


<%- include('../partials/footer'); %>