<%- include('../partials/header'); %>
<%- include('../partials/navbar'); %>
<title>Clientes</title>
<style>
    .navbar-dark {
        position: fixed !important;
        width: 100%;
        top: 0;
        left: 0;
        border-bottom: 1px solid rgba(256, 256, 256, 0.1);
        z-index: 999;
    }

    .bg-header {
        background: linear-gradient(rgba(9, 30, 62, 0.7), rgba(9, 30, 62, 0.7)), url(../img/banners/advogado.jpg) center center no-repeat;
        background-size: cover;
    }
</style>

<% if (successMessage) { %>
    <div class="alert alert-success" id="success">
        <%= successMessage %>
    </div>
<% } %>

<div class="container-fluid bg-primary py-5 bg-header" style="margin-bottom: 90px">
    <div class="row py-5">
        <div class="col-12 pt-lg-5 mt-lg-5 text-center">
            <h1 class="display-4 text-white animated zoomIn">Painel de Admin</h1>
        </div>
    </div>
</div>

<div class="container mt-5 d-flex gap-4 flex-column">
    <div class="row">
        <div class="col-md-6">
            <a href="/clientes" class="btn bg-warning br-10 text-white">
                <i class="fa fa-arrow-left" aria-hidden="true"></i> Voltar
            </a>
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-success text-white " data-bs-toggle="modal" id="btnAddServico" data-bs-target="#modaladdservico">
                <i class="fa fa-plus" aria-hidden="true"></i> Adicionar Serviço
            </button>
            <!-- <a href="/deletar/<%= cliente._id %>" id="btnDeletar" class="btn bg-danger br-10 text-white">
                <i class="fa fa-trash" aria-hidden="true"></i> Deletar Cliente
            </a> -->

            <% if (currentUser.credencial.acesso == 'SA' || currentUser.credencial.acesso == 'A') { %>
                <a href="/editar/<%= cliente._id %>" class="btn btn-primary br-10 text-white">
                    <i class="fa fa-pen" aria-hidden="true"></i> Editar
                </a>
            <% }  else { %>
                    
            <% } %>
            
            <% if (currentUser.credencial.acesso == 'SA') { %>
                <button class="btn btn-danger text-white " data-bs-toggle="modal" id="btnDeletar" data-bs-target="#confirmDeleteModal">
                    <i class="fa fa-trash" aria-hidden="true"></i> Deletar Cliente
                </button>
            <% }  else { %>

            <% } %>
            
        </div>
    </div>
    
    <h1>Visualização do Cliente</h1>
    <hr>

    <!-- Dados Pessoais -->
    <div>
        <h2>Dados Pessoais</h2>
        <div class="row">
            <div class="col-md-6 infos-pessoais">
                <p><strong>Nome:</strong> <%= cliente.info.nome %></p>
                <p><strong>Data de Nascimento:</strong> <span class="testeee"><%= cliente.info.dataNascimento %></span></p>
                <p><strong>CPF:</strong> <%= cliente.info.cpf %></p>
                <p><strong>RG:</strong> <%= cliente.info.rg %></p>
            </div>
            <div class="col-md-6">
                <p><strong>CNPJ:</strong> <%= cliente.info.cnpj %></p>
                <p><strong>Inscrição Estadual:</strong> <%= cliente.info.inscricaoEstadual %></p>
            </div>
        </div>
    </div>

    <!-- Endereço -->
    <div>
        <h2>Endereço</h2>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Cidade:</strong> <%= cliente.info.endereco.cidade %></p>
                <p><strong>CEP:</strong> <%= cliente.info.endereco.cep %></p>
                <p><strong>Bairro:</strong> <%= cliente.info.endereco.bairro %></p>
                <p><strong>Endereço:</strong> <%= cliente.info.endereco.endereco %></p>
                <p><strong>Número:</strong> <%= cliente.info.endereco.numero %></p>
            </div>
            <div class="col-md-6">
                <p><strong>UF:</strong> <%= cliente.info.endereco.uf %></p>
                <p><strong>Complemento:</strong> <%= cliente.info.endereco.complemento %></p>
            </div>
        </div>
    </div>

    <!-- Contato -->
    <div>
        <h2>Contato</h2>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Telefone Celular 1:</strong> <%= cliente.info.contato.telCelular1 %></p>
                <p><strong>Telefone Celular 2:</strong> <%= cliente.info.contato.telCelular2 %></p>
            </div>
            <div class="col-md-6">
                <p><strong>Telefone Residencial:</strong> <%= cliente.info.contato.telResidencial %></p>
                <p><strong>Telefone Comercial:</strong> <%= cliente.info.contato.telComercial %></p>
            </div>
        </div>
    </div>

    <!-- Outros -->
    <div>
        <h2>Outros</h2>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Nome do Pai:</strong> <%= cliente.info.outros.complementos.nomepai %></p>
                <p><strong>Nome da Mãe:</strong> <%= cliente.info.outros.complementos.nomemae %></p>
                <p><strong>Nome da Empresa:</strong> <%= cliente.info.outros.complementos.nomeempresa %></p>
                <p><strong>Cargo na Empresa:</strong> <%= cliente.info.outros.complementos.cargoempresa %></p>
            </div>
            <div class="col-md-6">
                <p><strong>Trabalha desde:</strong> <%= cliente.info.outros.complementos.trabalhadesde %></p>
                <p><strong>Site:</strong> <%= cliente.info.outros.site %></p>
                <p><strong>Email:</strong> <%= cliente.info.outros.email %></p>
            </div>
        </div>
    </div>

    <!-- Observações -->
    <div>
        <h2>Observações</h2>
        <div class="row">
            <p><%= cliente.info.observacoes %></p>
        </div>
    </div>
    
</div>

<%- include('./partials/excluir'); %>
<%- include('./partials/addservico'); %>
<%- include('../partials/footer'); %>


<script>

function formatDate(date) {
    const options = { year: 'numeric', month: 'long', day: 'numeric' };

    // Converter a data de texto em um objeto de data
    const dateObj = new Date(date);

    // Adicionar 1 dia à data
    dateObj.setDate(dateObj.getDate() + 1);

    // Formatar a data ajustada
    return dateObj.toLocaleDateString('pt-BR', options);
}

const dataNascElements = document.querySelectorAll('.testeee');
dataNascElements.forEach(element => {
    element.textContent = formatDate(element.textContent);
});

</script>