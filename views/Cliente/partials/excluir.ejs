<div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" style="z-index: 12371726391782397812;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">
                    Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Tem certeza de que deseja deletar este cliente?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success  px-3" data-bs-dismiss="modal">
                    <i class="fa-solid fa-circle-xmark"></i> Cancelar
                </button>
                <a href="/deletar/<%= cliente._id %>" id="btnDeletar" class="btn btn-danger">Deletar</a>
            </div>
        </div>
    </div>
</div>